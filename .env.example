# BitRich Environment Configuration
# Copy this file to .env and update the values

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-this-in-production

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///bitrich.db
# DATABASE_URL=postgresql://user:password@localhost/bitrich

# SendGrid Email Configuration
# Get your API key from https://sendgrid.com
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=noreply@example.com

# Stripe Payment Configuration
# Get your keys from https://stripe.com/docs/keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Coinbase API (optional - for exchange rates)
# The app uses CoinGecko free API by default
COINBASE_API_KEY=
